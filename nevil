#!/bin/bash

# Cleanup function for proper shutdown
cleanup() {
    echo ""
    echo "🧹 Cleaning up ROS2 and audio processes..."
    
    # Kill any ROS2 processes
    pkill -f "ros2 launch" 2>/dev/null || true
    pkill -f "ros2 run" 2>/dev/null || true
    
    # Kill any audio processes that might be holding the HifiBerry DAC
    pkill -f "speech_synthesis" 2>/dev/null || true
    pkill -f "speech_recognition" 2>/dev/null || true
    pkill -f "pygame" 2>/dev/null || true
    pkill -f "aplay" 2>/dev/null || true
    pkill -f "alsamixer" 2>/dev/null || true
    
    # Wait a moment for processes to fully terminate
    sleep 1
    
    # Clean up ALSA config
    rm -f /tmp/nevil_asoundrc 2>/dev/null || true
    
    # Stop and restart ROS2 daemon to clear ghost nodes
    ros2 daemon stop 2>/dev/null || true
    ros2 daemon start 2>/dev/null || true
    
    echo "✅ Cleanup complete"
    exit 0
}

# Set up signal traps for clean shutdown
trap cleanup SIGINT SIGTERM

# Activate Python venv (DISABLED - using system Python now)
# source ./nevil2env/bin/activate

# Source ROS 2 overlays (parent first, then workspace)
source ~/ros2_humble/install/setup.bash
source ~/Nevil-picar-v2/install/setup.bash

#Set Pulse device for Mic
# NOTE: PyAudio uses PortAudio, which opens ALSA's "default" device. On Bookworm,
# ALSA "default" is routed through the Pulse/PipeWire shim. Show Pyaudio default input device info:
# python3 -c "import pyaudio; p=pyaudio.PyAudio(); print('Default:', p.get_default_input_device_info() if p.get_default_input_device_info() else 'None'); p.terminate()"
#That means PyAudio's default input (always shown as index 7, name 'default') actually maps to whatever
# Pulse has chosen as its Default Source. By default Pulse often grabs a monitor
# (speaker loopback) instead of the real USB mic. To inspect available sources:
#   pactl list short sources
# and to set the USB mic as the default (persisted by WirePlumber):
#   pactl set-default-source alsa_input.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-mono
# Verify with:
#   pactl info | grep 'Default Source'
pactl set-default-source alsa_input.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-mono


