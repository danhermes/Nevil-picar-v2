#!/bin/bash
# Wrapper script for speech_synthesis_node

# echo "WRAPPER: speech_synthesis_node wrapper script starting"

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# echo "WRAPPER: SCRIPT_DIR=$SCRIPT_DIR"

# Use system Python3 (all packages now installed there)
SYSTEM_PYTHON="/usr/bin/python3"
# echo "WRAPPER: Using system Python: $SYSTEM_PYTHON"

# Source ROS2 environment to ensure workspace packages are available
source /home/dan/ros2_humble/install/setup.bash
source /home/dan/Nevil-picar-v2/install/setup.bash

# Load environment variables from .env file
if [ -f "/home/dan/Nevil-picar-v2/.env" ]; then
    set -a  # automatically export all variables
    source /home/dan/Nevil-picar-v2/.env
    set +a  # stop automatically exporting
fi

# Ensure logs directory exists
mkdir -p "$ROS_LOG_DIR"

# Execute the node using system Python with ALSA message suppression
# echo "WRAPPER: Executing speech_synthesis_node with system Python"
exec "$SYSTEM_PYTHON" -m nevil_interfaces_ai.speech_synthesis_node "$@" 2>&1 | grep -v "ALSA lib"