# Get absolute path to ros2 binary (inside overlay)
ros2_cli="$(which ros2)"


# Dispatch logic
if [[ "$1" == "launch" ]]; then
    shift
    if [[ -z "$1" ]]; then
        echo "? Error: No launch file specified."
        exit 1
    fi
    # kill everything in ros2 node list
    "$ros2_cli" node list | while read N; do
        NAME="${N##*/}"
        echo "Stopping $N"
        pkill -SIGINT -f "__node:=$NAME" || pkill -TERM -f "__node:=$NAME" || pkill -9 -f "__node:=$NAME"
    done
    sleep 0.5
    # Clear any existing audio processes before launching
    echo "🔧 Clearing existing audio processes..."
    pkill -f "speech_synthesis" 2>/dev/null || true
    pkill -f "speech_recognition" 2>/dev/null || true  
    pkill -f "pygame" 2>/dev/null || true
    pkill -f "aplay" 2>/dev/null || true
    sleep 0.5  # Brief pause to ensure processes are terminated
    
    echo "? Launching with: $ros2_cli launch $@"
    #sudo -E env PYTHONPATH="$PYTHONPATH" LD_LIBRARY_PATH="$LD_LIBRARY_PATH" "$ros2_cli" launch "$@"     
