# ALSA configuration to prevent underrun errors
# This file should be placed in the home directory or /etc/asound.conf

pcm.!default {
    type pulse
    server unix:/tmp/pulse-socket
}

ctl.!default {
    type pulse
    server unix:/tmp/pulse-socket
}

# Hardware PCM configuration with larger buffers
pcm.hw_optimized {
    type hw
    card 0
    device 0
    format S16_LE
    rate 44100
    channels 2
    buffer_size 4096
    period_size 1024
}

# Software mixing with optimized buffer sizes
pcm.dmix_optimized {
    type dmix
    ipc_key 1024
    slave {
        pcm "hw:0,0"
        format S16_LE
        rate 44100
        channels 2
        buffer_size 4096
        period_size 1024
        periods 4
    }
    bindings {
        0 0
        1 1
    }
}

# Capture device with optimized settings
pcm.dsnoop_optimized {
    type dsnoop
    ipc_key 2048
    slave {
        pcm "hw:0,0"
        format S16_LE
        rate 44100
        channels 2
        buffer_size 4096
        period_size 1024
        periods 4
    }
    bindings {
        0 0
        1 1
    }
}

# Full duplex device
pcm.duplex_optimized {
    type asym
    playback.pcm "dmix_optimized"
    capture.pcm "dsnoop_optimized"
}